<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Header Branding -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SK Bank of India"
        android:textColor="#0A192F"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Electronic Payment Receipt • Verified"
        android:textColor="#138808"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Amount Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E8F5E9"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ PAYMENT COMPLETED"
            android:textColor="#138808"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvReceiptAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 0.00"
            android:textColor="#0A192F"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Details Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F4F6F9"
        android:padding="14dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvReceiptTxnRef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Txn Ref: TXN202511250001"
            android:textColor="#0A192F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvReceiptPayee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paid To: Ramesh Sharma"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvReceiptMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Method: INTERNAL_TRANSFER"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvReceiptTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date: 25-Nov-2026 17:45"
            android:textColor="#666666"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Action Buttons Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnReceiptPrint"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="Print 🖨️"
            android:textSize="11sp"
            android:backgroundTint="#0A192F"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnReceiptDownload"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="PDF 📄"
            android:textSize="11sp"
            android:backgroundTint="#0052CC"
            android:textColor="#FFFFFF"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnReceiptShare"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="Share 📲"
            android:textSize="11sp"
            android:backgroundTint="#FF9933"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnReceiptDone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Done &amp; Close ✔"
        android:backgroundTint="#138808"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
