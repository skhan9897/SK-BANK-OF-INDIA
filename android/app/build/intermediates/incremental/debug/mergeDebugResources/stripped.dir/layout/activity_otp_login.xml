<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#F4F6F9">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_bank_logo"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SK Bank Mobile Login"
        android:textColor="#0A192F"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your registered mobile number for instant OTP verification"
        android:textColor="#555555"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etMobileNumber"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Mobile Number (+91)"
        android:inputType="phone"
        android:maxLength="10"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGenerateOtp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Generate OTP"
        android:backgroundTint="#0052CC"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/layoutOtpSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Enter 4-Digit OTP"
            android:inputType="number"
            android:maxLength="4"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Verify OTP &amp; Proceed"
            android:backgroundTint="#00875A"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
