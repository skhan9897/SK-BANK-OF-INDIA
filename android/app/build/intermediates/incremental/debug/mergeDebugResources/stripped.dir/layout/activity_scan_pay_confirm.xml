<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan &amp; Pay Confirmation"
            android:textColor="#0A192F"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Review Recipient &amp; Confirm Instant Ledger Payment"
            android:textColor="#8892B0"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- Recipient Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAYING TO RECIPIENT"
                android:textColor="#8892B0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvRecipientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verifying Recipient..."
                android:textColor="#0A192F"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvRecipientVpa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="vpa@skbank"
                android:textColor="#0052CC"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <EditText
            android:id="@+id/etPayAmount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter Amount (₹)"
            android:inputType="numberDecimal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPayRemarks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Add Note / Remarks (Optional)"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnConfirmPay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Confirm &amp; Send Payment ✔"
            android:backgroundTint="#FF9933"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
