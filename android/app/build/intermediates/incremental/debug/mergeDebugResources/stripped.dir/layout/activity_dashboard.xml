<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sk_dark_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvProfileAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/tricolor_progress_drawable"
                        android:textColor="#FFFFFF"
                        android:text="SK"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWelcomeUser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SK Bank of India ▾"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDashAccountNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mumbai Main Branch • 10018877665544"
                            android:textColor="@color/sk_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnHeaderSearch"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="🔍"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btnHeaderNotif"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="🔔"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btnLogout"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="❓"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF" />

                </LinearLayout>

            </RelativeLayout>

            <!-- Promotional Banner Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/sk_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AD • Get 100% Digital Banking"
                    android:textColor="@color/sk_gold"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instant Pre-Approved Loans Under 7 mins"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instant Sanction up to ₹ 5,00,000 at lowest interest rates"
                    android:textColor="@color/sk_text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnBannerCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Check Eligibility ➔"
                    android:textSize="11sp"
                    android:backgroundTint="@color/sk_purple_primary"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <!-- Transfer Money Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transfer Money"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/btnTransferMobile"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/sk_card_light"
                        android:text="👤"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="To Mobile\nNumber"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnTransferBank"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/sk_card_light"
                        android:text="🏦"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="To Bank/\nUPI ID"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnTransferSelf"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/sk_card_light"
                        android:text="🔄"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="To Self\nAccount"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCheckBalance"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/sk_card_light"
                        android:text="🏛️"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check Bank\nBalance"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

            </LinearLayout>

            <!-- UPI ID Bar -->
            <LinearLayout
                android:id="@+id/btnUpiBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/sk_card_bg"
                android:padding="14dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvUpiIdDisplay"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="UPI ID: customer@skbank"
                    android:textColor="@color/sk_text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDashBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 10,000.00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnToggleBalance"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:text="👁"
                    android:textSize="12sp"
                    android:backgroundTint="@color/sk_card_light"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <!-- Quick Features (3 Cards) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/btnWalletCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="80dp"
                    android:background="@color/sk_card_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💼"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SK Wallet"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMyQrCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="80dp"
                    android:background="@color/sk_card_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My QR Code"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnChatCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="80dp"
                    android:background="@color/sk_card_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat &amp; Send"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Recharge & Pay Bills Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recharge &amp; Pay Bills"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/btnMobileRecharge"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/sk_card_light"
                        android:text="⚡"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile\nRecharge"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFastag"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/sk_card_light"
                        android:text="🚗"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buy\nFASTag"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDth"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/sk_card_light"
                        android:text="📡"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DTH\nRecharge"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnElectricity"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/sk_card_light"
                        android:text="💡"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Electricity\nBill"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar with Floating Central Scanner -->
    <RelativeLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/sk_dark_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/navBank"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🏛️ Bank/Ac"
                android:textSize="10sp"
                android:backgroundTint="@color/sk_dark_bg"
                android:textColor="@color/sk_gold" />

            <Button
                android:id="@+id/navCards"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="💳 Cards"
                android:textSize="10sp"
                android:backgroundTint="@color/sk_dark_bg"
                android:textColor="#FFFFFF" />

            <!-- Spacer for Floating Scanner -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Button
                android:id="@+id/navLoans"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="💰 Loans"
                android:textSize="10sp"
                android:backgroundTint="@color/sk_dark_bg"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/navPassbook"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="📜 History"
                android:textSize="10sp"
                android:backgroundTint="@color/sk_dark_bg"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Floating Central Purple QR Scan & Pay Button -->
        <TextView
            android:id="@+id/btnCentralScanPay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerInParent="true"
            android:background="@color/sk_purple_primary"
            android:textColor="#FFFFFF"
            android:text="📷\nScan"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:elevation="6dp" />

    </RelativeLayout>

</RelativeLayout>
