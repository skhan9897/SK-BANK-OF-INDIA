<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0A192F"
    android:padding="28dp">

    <ProgressBar
        android:id="@+id/pbTricolorLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="20dp"
        android:indeterminateTint="#FF9933" />

    <TextView
        android:id="@+id/tvLoadingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Processing Request..."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvLoadingSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 Securing Double-Entry Ledger Entry..."
        android:textColor="#FFC107"
        android:textSize="13sp"
        android:textAlignment="center" />

</LinearLayout>
