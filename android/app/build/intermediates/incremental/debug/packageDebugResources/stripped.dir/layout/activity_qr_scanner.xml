<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sk_dark_bg">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/headerScanner"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/sk_dark_bg"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBackScanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan any QR"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />

        <TextView
            android:id="@+id/btnHelpScanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❓"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

    </RelativeLayout>

    <!-- Main Scanner Viewfinder Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerScanner"
        android:layout_above="@id/bottomSheetDrawer"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Purple Border Frame with SurfaceView -->
        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="@color/sk_card_bg"
            android:padding="4dp"
            android:layout_marginBottom="24dp">

            <SurfaceView
                android:id="@+id/svCameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Scanner Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/sk_purple_glow"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Gallery & Flashlight Action Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPickGallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@color/sk_card_bg"
                android:text="🖼️"
                android:gravity="center"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="20dp" />

            <TextView
                android:id="@+id/btnToggleFlash"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@color/sk_card_bg"
                android:text="⚡"
                android:gravity="center"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Sheet Drawer (Quick Send) -->
    <LinearLayout
        android:id="@+id/bottomSheetDrawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/sk_card_bg"
        android:padding="20dp">

        <!-- Pull Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/sk_text_muted"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Search Mobile Number or Name Box -->
        <EditText
            android:id="@+id/etSearchContact"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Enter mobile number or name"
            android:textColorHint="@color/sk_text_muted"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:background="@color/sk_card_light"
            android:layout_marginBottom="20dp" />

        <!-- Quick Send Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Send"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Horizontal Contacts Avatars -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/contactJuan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#00D2FF"
                        android:text="JA"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Juan"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contactMaria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#E91E63"
                        android:text="MA"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maria"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contactManual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/sk_gold"
                        android:text="MG"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contactMarta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#9C27B0"
                        android:text="MR"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marta"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contactJose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#00BFA5"
                        android:text="JS"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jose Diaz"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

</RelativeLayout>
