<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A192F"
    android:clipChildren="false">

    <!-- Animated Indian Flag Sea Wave Background View -->
    <ImageView
        android:id="@+id/ivFlagWaveBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="-60dp"
        android:scaleType="centerCrop"
        android:contentDescription="Indian Flag Sea Wave Background"
        android:src="@drawable/indian_flag_wave_bg" />

    <!-- Center Content Structure -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Indian Flag Bank Logo -->
        <ImageView
            android:id="@+id/ivBankLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="SK Bank Tricolor Logo"
            android:src="@drawable/ic_bank_logo"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvLogoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SK Bank of India"
            android:textColor="#0A192F"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#0A192F"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="🇮🇳 PROUDLY LAUNCHED IN INDIA"
            android:textColor="#FFB800"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tricolor Progress Bar -->
        <ProgressBar
            android:id="@+id/pbSplashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="230dp"
            android:layout_height="10dp"
            android:layout_marginTop="32dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/tricolor_progress_drawable" />

    </LinearLayout>

    <!-- Bottom Developer Credits -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVELOPED BY"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SAJID KHAN"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="RBI Regulated Digital Banking System • 2025"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
