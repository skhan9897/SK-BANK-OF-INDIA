<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A192F"
    android:padding="32dp">

    <!-- Center Content Structure Matching Web Splash -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Indian Flag Tricolor Wave Bank Logo -->
        <ImageView
            android:id="@+id/ivBankLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="SK Bank Tricolor Logo"
            android:src="@drawable/ic_bank_logo"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvLogoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SK Bank of India"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1A365D"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="🇮🇳 PROUDLY LAUNCHED IN INDIA"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Tricolor Indian Flag Wave Progress Bar -->
        <ProgressBar
            android:id="@+id/pbSplashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="8dp"
            android:layout_marginTop="28dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/tricolor_progress_drawable" />

    </LinearLayout>

    <!-- Bottom Developer Credits Matching Web Splash -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVELOPED BY"
            android:textColor="#8892B0"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SAJID KHAN"
            android:textColor="#D4AF37"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="RBI Regulated Digital Banking System • 2025"
            android:textColor="#8892B0"
            android:textSize="10sp" />

    </LinearLayout>

</RelativeLayout>
