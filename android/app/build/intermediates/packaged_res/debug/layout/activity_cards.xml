<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debit &amp; Virtual Cards"
            android:textColor="#0A192F"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Card Preview Widget -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0A192F"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SK BANK OF INDIA"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="PLATINUM DEBIT"
                    android:textColor="#D4AF37"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4532  9012  3456  9812"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VALID THRU: 12/28"
                    android:textColor="#8892B0"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="VISA"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Controls -->
        <Switch
            android:id="@+id/swLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Card Status (Unlocked &amp; Active)"
            android:textSize="15sp"
            android:checked="true"
            android:layout_marginBottom="16dp" />

        <Switch
            android:id="@+id/swIntl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="International Online Usage"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnIssueVirtual"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Issue Instant Virtual Card"
            android:backgroundTint="#0052CC"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnResetPin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Reset Card PIN"
            android:backgroundTint="#0A192F"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
