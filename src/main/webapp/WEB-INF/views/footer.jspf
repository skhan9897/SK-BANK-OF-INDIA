                    <li class="mb-2"><a href="${pageContext.request.contextPath}/transfers.jsp"><i class="fa-solid fa-angle-right me-1"></i> UPI & IMPS Transfer</a></li>
                    <li class="mb-2"><a href="${pageContext.request.contextPath}/loans.jsp"><i class="fa-solid fa-angle-right me-1"></i> Instant Loans</a></li>
